{
  "name": "tek-city",
  "version": "0.3.0-beta",
  "private": true,
  "description": "TEK CITY (Beta) - cooperative, server-authoritative online city-building game. Off-chain only.",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "NODE_ENV=development node server/index.js",
    "build": "node scripts/build-client.js",
    "test": "node --test --test-concurrency=1 test/",
    "migrate": "node server/db/migrate.js",
    "backup": "node scripts/backup.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@solana/web3.js": "^1.99.0",
    "cookie": "^1.1.1",
    "express": "^4.22.3",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "socket.io": "^4.8.4",
    "tweetnacl": "^1.0.3"
  },
  "optionalDependencies": {
    "embedded-postgres": "^17.6.0-beta.15"
  },
  "devDependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@solana/wallet-standard-features": "^1.3.0",
    "@wallet-standard/app": "^1.1.0",
    "@wallet-standard/base": "^1.1.0",
    "esbuild": "^0.28.2",
    "lucide": "^1.52.0",
    "socket.io-client": "^4.8.4",
    "three": "^0.170.0"
  }
