# Copy to .env for local development. Never commit real values.
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
API_URL=http://localhost:3000
# 32+ random characters. In Render use "Generate".
SESSION_SECRET=replace-with-a-long-random-string
# Postgres connection string. Leave empty locally to use an embedded, non-persistent Postgres.
DATABASE_URL=
REDIS_URL=
SOLANA_NETWORK=devnet
# Server-side only. Never exposed to the browser.
SOLANA_RPC_URL=
ALLOWED_ORIGINS=http://localhost:3000
SENTRY_DSN=
# Comma-separated Solana addresses allowed to use /admin. Empty = admin disabled.
ADMIN_WALLET_ALLOWLIST=
FEATURE_WALLET_CONNECT=true
FEATURE_MARKET_DATA=false
FEATURE_ONCHAIN_ACTIONS=false
FEATURE_MAINNET=false
# Optional official links. Leave empty for "Not announced".
OFFICIAL_X_URL=
OFFICIAL_DISCORD_URL=
OFFICIAL_TELEGRAM_URL=
OFFICIAL_AUDIT_STATUS=
SUPPORT_EMAIL=

# ----- Launchpad (Pump.fun) -----
FEATURE_LAUNCHPAD=true
# Pinata JWT for coin image + metadata uploads (secret, server only)
PINATA_JWT=
# TEK CITY token mint (ends in "pump"). Set after launch. SPIN_MODE=bought (default): 1 free starter spin, then
# 1 spin per TOKENS_PER_SPIN bought (wallet + verified pump.fun profile). No refill for holding. Until it's set: 1 spin per round.
OFFICIAL_TOKEN_MINT=
TOKENS_PER_SPIN=500000
SPIN_MODE=bought
STARTER_SPINS=1
# Read-only pump.fun profile link (bio code) so buys from a pump.fun email/X wallet count.
FEATURE_PUMP_BIO_LINK=true
VAULT_COOLDOWN_HOURS=12
VAULT_JACKPOT_SPINS=1
MAX_BUY_LAMPORTS=800000000
MIN_BUY_LAMPORTS=10000000

# ----- Creator-reward Community Fund (public keys only, never secrets) -----
# Wallet that receives creator rewards for TEK CITY-operated coins.
OPERATOR_CREATOR_REWARD_WALLET=
# Community Fund treasury (multisig recommended). Must differ from the operator wallet and the token mint.
COMMUNITY_TREASURY_WALLET=
# Integer basis points. Must sum to 10000. community = floor(amount * bps / 10000); the remainder stays with the operator.
COMMUNITY_FUND_ALLOCATION_BPS=2000
OPERATOR_REWARD_RETAINED_BPS=8000
# Keep false until approved. While false: no program activation, no grants, no payouts. Accounting still runs.
COMMUNITY_FUND_ENABLED=false
COMMUNITY_FUND_PAUSED=false
COMMUNITY_FUND_POLICY_URL=
# RBAC for /admin Community Fund tools: "address:role|role;address:role". Roles: coin_approver, policy_admin,
# program_admin, grant_approver, ledger_reconciler. The address must also be in ADMIN_WALLET_ALLOWLIST.
ADMIN_WALLET_ROLES=
# Retired. Do not set. The server holds no signer for any wallet.
# REWARDS_WALLET_SECRET=
